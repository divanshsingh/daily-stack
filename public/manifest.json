{
    "manifest_version": 3,
    "name": "TDS - The Daily Stack",
    "short_name": "TDS",
    "version": "1.0.0",
    "description": "A personal task tracker for daily consistency.",
    "permissions": [
        "storage",
        "sidePanel"
    ],
    "icons": {
        "128": "icons/icon128.png"
    },    
    "action": {
        "default_title": "TDS - The Daily Stack"
    },
    "background": {
        "service_worker": "service-worker.js"
    }, 
    "side_panel": {
        "default_path": "index.html"
    }
}
